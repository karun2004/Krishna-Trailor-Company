NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# REQUIRED in production (>= 16 chars, secret, e.g. `openssl rand -hex 32`). The enquiry API returns 500 if it is missing/short
# when NODE_ENV=production. Dev/test fall back to a built-in dev-only value.
ENQUIRY_IP_PEPPER=
# Public site origin (canonicals, sitemap, JSON-LD). Defaults to http://localhost:3100 when blank.
NEXT_PUBLIC_SITE_URL=
